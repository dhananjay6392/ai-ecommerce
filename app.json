                                 "versionCode":  1,
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/android-icon-foreground.png",
                                                      "backgroundColor":  "#0B0F19"
                                                  },
                                 "permissions":  [
                                                     "INTERNET",
                                                     "ACCESS_NETWORK_STATE"
                                                 ]
                             },
                 "web":  {
                             "favicon":  "./assets/icon.png"
                         }
             }
}
