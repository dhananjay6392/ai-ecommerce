{
    "expo":  {
                 "name":  "IntelliCart AI",
                 "slug":  "intellicart-ai",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/icon.png",
                 "userInterfaceStyle":  "dark",
                 "newArchEnabled":  false,
